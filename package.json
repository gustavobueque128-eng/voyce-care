{
  "name": "voyce-care",
  "version": "1.0.0",
  "private": true,
  "description": "Voyce Care - sistema de anotação de enfermagem por voz (React + Express + SQLite)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"node server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "start:https": "node server/index.js --https"
  },
  "dependencies": {
    "express": "4.19.2",
    "node-forge": "1.4.4",
    "sql.js": "1.8.0"
  },
  "devDependencies": {
    "concurrently": "7.6.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "vite": "2.9.18"
  },
  "engines": {
    "node": ">=14"
  }
}
